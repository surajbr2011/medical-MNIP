DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/mnip

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mnip_neo4j

# Ollama LLM Service
OLLAMA_HOST=http://localhost:11434
